{
  "name": "pensive-books",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.23.4",
      "@tiptap/pm": "3.23.4"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/node": "^22.19.19",
    "tsx": "^4.20.6"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @pensive/web dev",
    "dev:web": "corepack pnpm --filter @pensive/web dev",
    "dev:marketing": "corepack pnpm --filter @pensive/marketing dev",
    "dev:digest": "corepack pnpm --filter @pensive/digest dev",
    "dev:bridge": "node scripts/eval-bridge.mjs",
    "dev:claude-local-shim": "node scripts/claude-local-shim.mjs",
    "dev:claude-local-shim:restart": "pkill -f 'scripts/claude-local-shim.mjs' || true; nohup node scripts/claude-local-shim.mjs > nohup.out 2>&1 & disown; sleep 1; ps aux | grep '[c]laude-local-shim'",
    "dev:all": "trap 'kill 0' EXIT; node scripts/eval-bridge.mjs & corepack pnpm --parallel --filter @pensive/web --filter @pensive/marketing dev",
    "build": "corepack pnpm -r --if-present build",
    "build:web": "corepack pnpm --filter @pensive/web build",
    "build:marketing": "corepack pnpm --filter @pensive/marketing build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm --filter @pensive/web test:run",
    "setup:hooks": "bash scripts/setup-hooks.sh",
    "functions:start": "supabase start",
    "functions:stop": "supabase stop",
    "functions:serve": "supabase functions serve",
    "functions:logs": "supabase functions logs",
    "functions:list": "supabase functions list",
    "functions:check": "bash scripts/check-edge-functions.sh",
    "bridge:restart": "bash scripts/restart-local-bridge.sh",
    "dna:dryrun": "tsx --tsconfig scripts/harness/tsconfig.json scripts/agent-build-dryrun.mts",
    "dna:run": "tsx --tsconfig scripts/harness/tsconfig.json scripts/agent-build-run.mts",
    "dna:grade": "tsx --tsconfig scripts/harness/tsconfig.json scripts/eval-premise.mts"
  }
}
